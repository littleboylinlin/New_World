{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "new-world-site",
  "main": "worker.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "preview_urls": true,
  "routes": [
    { "pattern": "writenewworld.com", "custom_domain": true },
    { "pattern": "www.writenewworld.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    // Every request passes through worker.js so www can redirect to the main domain.
    "run_worker_first": true
  },
  "observability": { "enabled": true }
}
