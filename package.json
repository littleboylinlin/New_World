{
  "name": "new-world",
  "version": "0.14.1",
  "description": "本地小说管理器与写作工作台",
  "author": "小男孩",
  "private": true,
  "type": "module",
  "main": "desktop/main.cjs",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build-language-packs.mjs && tsc --noEmit && vite build",
    "preview": "vite preview",
    "desktop": "npm run build && electron .",
    "build:windows": "npm run build && node desktop/build-windows.mjs",
    "test": "npm run build && playwright test",
    "test:desktop": "playwright test --config desktop/playwright.config.mjs",
    "predev": "node scripts/build-language-packs.mjs",
    "build:macos": "npm run build && node desktop/build-macos.mjs",
    "test:macos": "playwright test --config desktop/playwright-macos.config.mjs"
  },
  "dependencies": {
    "@tiptap/core": "^3.33.0",
    "@tiptap/extension-image": "^3.33.0",
    "@tiptap/extension-table": "^3.33.0",
    "@tiptap/pm": "^3.33.0",
    "@tiptap/starter-kit": "^3.33.0",
    "@zip.js/zip.js": "^2.24.0",
    "docx": "^9.15.3",
    "mammoth": "^1.13.0",
    "markdown-it": "^15.0.3",
    "pdfjs-dist": "6.5.438",
    "turndown": "^7.2.5",
    "turndown-plugin-gfm": "^1.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/markdown-it": "^14.2.0",
    "@types/turndown": "^5.0.6",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.7",
    "vite-plugin-static-copy": "^4.1.1"
  }
}
